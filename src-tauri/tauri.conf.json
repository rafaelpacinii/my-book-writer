{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Book Writer",
  "version": "0.1.0",
  "identifier": "com.rafael.my-book-writer",
  "build": {
    "beforeDevCommand": "npm run pdf:prepare && npm run dev",
    "beforeBuildCommand": "npm run pdf:prepare && npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My Book Writer",
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/chromium/": "chromium/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Estúdio editorial local para escritores e criadores de livros.",
    "windows": {
      "wix": {
        "upgradeCode": "6f25fb73-78da-5a08-a1cf-bb5ac2b24784"
      }
    }
  },
  "mainBinaryName": "my-book-writer"
}
