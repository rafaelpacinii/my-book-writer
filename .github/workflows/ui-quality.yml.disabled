name: UI quality

on:
  pull_request:
    branches: [develop, main]
  push:
    branches: [develop, main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ui-${{ github.ref }}
  cancel-in-progress: true

jobs:
  browser:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npx playwright install --with-deps chromium firefox
      - run: npx next typegen
      - run: npm run typecheck
      - run: npm run lint
      - run: npm run check:ui
      - run: npm test
      - run: node --test src/tests/native/webdriver.test.mjs
      - run: npm run build -- --webpack
      - name: Test production export
        shell: bash
        run: |
          npm run preview:static > /tmp/mbw-static.log 2>&1 &
          preview_pid=$!
          trap 'kill "$preview_pid"' EXIT
          for attempt in {1..60}; do
            if curl -sf http://127.0.0.1:3100/home > /dev/null; then break; fi
            sleep 1
          done
          MBW_EDITOR_TEST_URL=http://127.0.0.1:3100 npm run test:e2e
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: browser-ui-results
          path: |
            src/tests/playwright-report
            src/tests/test-results

  windows-native:
    # Avoid the WebView2 automation regression in windows-2025-vs2026 (runner-images#14738).
    runs-on: windows-2022
    env:
      CARGO_TARGET_DIR: ${{ github.workspace }}/src-tauri/target/ui-tests
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - uses: dtolnay/rust-toolchain@stable
      - run: npm ci
      - run: npx playwright install chromium
      - run: cargo install tauri-driver --locked
      - name: Install Edge WebDriver matching the WebView2 runtime
        shell: pwsh
        run: |
          $runtimeRoot = "${env:ProgramFiles(x86)}/Microsoft/EdgeWebView/Application"
          if (!(Test-Path "$runtimeRoot/*/msedgewebview2.exe")) {
            $installer = "$env:RUNNER_TEMP/WebView2Setup.exe"
            Invoke-WebRequest 'https://go.microsoft.com/fwlink/p/?LinkId=2124703' -OutFile $installer
            $install = Start-Process $installer -ArgumentList '/silent', '/install' -Wait -PassThru
            if ($install.ExitCode -notin @(0, 3010)) {
              throw "WebView2 installation failed with exit code $($install.ExitCode)"
            }
          }
          $runtime = Get-ChildItem $runtimeRoot -Directory |
            Where-Object { Test-Path (Join-Path $_.FullName 'msedgewebview2.exe') } |
            Sort-Object { [version]$_.Name } -Descending |
            Select-Object -First 1
          if (!$runtime) { throw "WebView2 runtime was not found in $runtimeRoot" }
          $version = (Get-Item (Join-Path $runtime.FullName 'msedgewebview2.exe')).VersionInfo.ProductVersion
          Write-Host "WebView2 runtime: $version"
          Invoke-WebRequest "https://msedgedriver.microsoft.com/$version/edgedriver_win64.zip" -OutFile "$env:RUNNER_TEMP/edge-driver.zip"
          Expand-Archive "$env:RUNNER_TEMP/edge-driver.zip" "$env:RUNNER_TEMP/edge-driver"
          & "$env:RUNNER_TEMP/edge-driver/msedgedriver.exe" --version
          "MBW_EDGE_DRIVER=$env:RUNNER_TEMP/edge-driver/msedgedriver.exe" >> $env:GITHUB_ENV
      - name: Build the isolated production application
        run: npm run tauri build -- --no-bundle --config src-tauri/tauri.ui-test.conf.json
      - run: npm run test:native
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: windows-native-ui-results
          path: src/tests/test-results/native
