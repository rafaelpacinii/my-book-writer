{
  "name": "my-book-writer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report src/tests/playwright-report",
    "pdf:install": "playwright install chromium",
    "pdf:prepare": "node --experimental-strip-types src-tauri/prepareChromium.ts",
    "tauri": "tauri",
    "tauri:dev:wsl": "GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "typecheck": "tsc --noEmit --incremental false",
    "test:ui": "playwright test ui --project=chromium",
    "test:native": "node src/tests/native/ui.windows.mjs",
    "check:ui": "node src/tests/check-ui.mjs",
    "preview:static": "node src/tests/serve-static.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/api": "~2.12.4",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
